{
  "name": "harness-admin",
  "version": "0.1.9",
  "description": "A local dashboard for Specification-Driven Development projects",
  "type": "module",
  "bin": {
    "harness": "./dist/index.js",
    "harness-admin": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "keywords": [
    "sdd",
    "specification",
    "dashboard",
    "openspec",
    "cli",
    "tui"
  ],
  "author": "davicanuto",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davi-canuto/harness-admin.git"
  },
  "scripts": {
    "build": "pnpm --filter @harness/board build && pnpm --filter @harness/server build && pnpm --filter @harness/tui build && pnpm --filter @harness/parser build && tsup && rm -rf ./board-dist && cp -r ../board/dist ./board-dist",
    "build:cli": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@fastify/static": "^8.1.0",
    "@fastify/websocket": "^11.2.0",
    "chokidar": "^3.6.0",
    "fastify": "^5.1.0",
    "gray-matter": "^4.0.3",
    "ink": "^5.0.1",
    "open": "^10.1.0",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@harness/board": "workspace:*",
    "@harness/parser": "workspace:*",
    "@harness/server": "workspace:*",
    "@harness/tui": "workspace:*",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.3",
    "tsup": "^8.0.2",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "board-dist",
    "README.md"
  ]
}
